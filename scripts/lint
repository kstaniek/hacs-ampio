#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_dir"
python="$repo_dir/.venv/bin/python"
if [[ ! -x "$python" ]]; then
    printf 'Run scripts/setup before scripts/lint.\n' >&2
    exit 1
fi
unset PYTHONHOME PYTHONPATH

"$python" -m ruff format .
"$python" -m ruff check . --fix
